SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional. The server-side database service uses only the secret key.
SUPABASE_PUBLISHABLE_KEY=
# Optional server-side GitHub token. Public, unauthenticated access is the default.
GITHUB_TOKEN=
# Cache duration in minutes (10-15).
GITHUB_CACHE_MINUTES=15
# Optional comma-separated production frontend origins. Localhost/127.0.0.1
# development origins are allowed with any port.
CORS_ALLOWED_ORIGINS=
